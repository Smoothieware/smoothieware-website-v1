(version 1)
(rule "J_HOST1 sourced fine pitch pads" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('J_HOST1') && B.memberOfFootprint('J_HOST1')") (constraint clearance (min 0.16mm)))
(rule "J_CHAIN1 sourced fine pitch pads" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.memberOfFootprint('J_CHAIN1') && B.memberOfFootprint('J_CHAIN1')") (constraint clearance (min 0.16mm)))
(rule "host coil functional isolation" (condition "(A.hasNetclass('HOST') && B.hasNetclass('COIL')) || (B.hasNetclass('HOST') && A.hasNetclass('COIL'))") (constraint clearance (min 3.4mm)))
(rule "LOAD_1 to other domains" (condition "(A.hasNetclass('LOAD_1') && !B.hasNetclass('LOAD_1')) || (B.hasNetclass('LOAD_1') && !A.hasNetclass('LOAD_1'))") (constraint clearance (min 8mm)))
(rule "LOAD_2 to other domains" (condition "(A.hasNetclass('LOAD_2') && !B.hasNetclass('LOAD_2')) || (B.hasNetclass('LOAD_2') && !A.hasNetclass('LOAD_2'))") (constraint clearance (min 8mm)))
(rule "LOAD_3 to other domains" (condition "(A.hasNetclass('LOAD_3') && !B.hasNetclass('LOAD_3')) || (B.hasNetclass('LOAD_3') && !A.hasNetclass('LOAD_3'))") (constraint clearance (min 8mm)))
(rule "LOAD_4 to other domains" (condition "(A.hasNetclass('LOAD_4') && !B.hasNetclass('LOAD_4')) || (B.hasNetclass('LOAD_4') && !A.hasNetclass('LOAD_4'))") (constraint clearance (min 8mm)))
(rule "LOAD_5 to other domains" (condition "(A.hasNetclass('LOAD_5') && !B.hasNetclass('LOAD_5')) || (B.hasNetclass('LOAD_5') && !A.hasNetclass('LOAD_5'))") (constraint clearance (min 8mm)))
(rule "LOAD_6 to other domains" (condition "(A.hasNetclass('LOAD_6') && !B.hasNetclass('LOAD_6')) || (B.hasNetclass('LOAD_6') && !A.hasNetclass('LOAD_6'))") (constraint clearance (min 8mm)))
(rule "LOAD_7 to other domains" (condition "(A.hasNetclass('LOAD_7') && !B.hasNetclass('LOAD_7')) || (B.hasNetclass('LOAD_7') && !A.hasNetclass('LOAD_7'))") (constraint clearance (min 8mm)))
(rule "M3 hardware copper keepout" (condition "(A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X > 3.0mm && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4'))) || (B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X > 3.0mm && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4')))") (constraint hole_clearance (min 2.4mm)))
(rule "LOAD_1 to M3 Ø7mm hardware" (condition "((A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X > 3.0mm && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4'))) && B.hasNetclass('LOAD_1')) || ((B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X > 3.0mm && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4'))) && A.hasNetclass('LOAD_1'))") (constraint hole_clearance (min 9.9mm)))
(rule "LOAD_2 to M3 Ø7mm hardware" (condition "((A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X > 3.0mm && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4'))) && B.hasNetclass('LOAD_2')) || ((B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X > 3.0mm && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4'))) && A.hasNetclass('LOAD_2'))") (constraint hole_clearance (min 9.9mm)))
(rule "LOAD_3 to M3 Ø7mm hardware" (condition "((A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X > 3.0mm && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4'))) && B.hasNetclass('LOAD_3')) || ((B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X > 3.0mm && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4'))) && A.hasNetclass('LOAD_3'))") (constraint hole_clearance (min 9.9mm)))
(rule "LOAD_4 to M3 Ø7mm hardware" (condition "((A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X > 3.0mm && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4'))) && B.hasNetclass('LOAD_4')) || ((B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X > 3.0mm && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4'))) && A.hasNetclass('LOAD_4'))") (constraint hole_clearance (min 9.9mm)))
(rule "LOAD_5 to M3 Ø7mm hardware" (condition "((A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X > 3.0mm && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4'))) && B.hasNetclass('LOAD_5')) || ((B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X > 3.0mm && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4'))) && A.hasNetclass('LOAD_5'))") (constraint hole_clearance (min 9.9mm)))
(rule "LOAD_6 to M3 Ø7mm hardware" (condition "((A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X > 3.0mm && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4'))) && B.hasNetclass('LOAD_6')) || ((B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X > 3.0mm && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4'))) && A.hasNetclass('LOAD_6'))") (constraint hole_clearance (min 9.9mm)))
(rule "LOAD_7 to M3 Ø7mm hardware" (condition "((A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X > 3.0mm && (A.memberOfFootprint('H1') || A.memberOfFootprint('H2') || A.memberOfFootprint('H3') || A.memberOfFootprint('H4'))) && B.hasNetclass('LOAD_7')) || ((B.Pad_Type == 'NPTH, mechanical' && B.Hole_Size_X > 3.0mm && (B.memberOfFootprint('H1') || B.memberOfFootprint('H2') || B.memberOfFootprint('H3') || B.memberOfFootprint('H4'))) && A.hasNetclass('LOAD_7'))") (constraint hole_clearance (min 9.9mm)))
