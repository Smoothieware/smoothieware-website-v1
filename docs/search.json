[{% assign first = true %}{% for page in site.pages %}{% assign ext = page.name | split: "." | last %}{% if ext == "md" and page.sitemap != false and page.title %}{% unless page.url contains "/debug" or page.url contains "-for-include" %}{% assign heads = "" %}{% assign lines = page.content | newline_to_br | split: "<br />" %}{% for line in lines %}{% assign t = line | strip %}{% assign two = t | slice: 0, 3 %}{% if two == "## " %}{% assign h = t | remove_first: "## " | split: " {#" | first | strip_html %}{% assign heads = heads | append: h | append: " · " %}{% endif %}{% endfor %}{% assign chunks = page.content | split: "<h2" %}{% for chunk in chunks offset:1 %}{% assign h = chunk | split: "</h2>" | first | prepend: "<h2" | strip_html | strip %}{% assign heads = heads | append: h | append: " · " %}{% endfor %}{% unless first %},{% endunless %}{% assign first = false %}
{"title":{{ page.title | strip_html | jsonify }},"url":{{ page.url | relative_url | jsonify }},"headings":{{ heads | truncate: 300 | jsonify }}}{% endunless %}{% endif %}{% endfor %}
